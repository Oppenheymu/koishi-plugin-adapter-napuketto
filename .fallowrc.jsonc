{
    // fallow 配置（2026-08-09）：koishi-plugin-adapter 子仓库专用。
    // 只豁免已确认的误报源/框架契约/有意设计，不放松重复与复杂度阈值。
    // 本文件在子仓库根（apps/koishi-plugin-adapter/），fallow 自动发现
    // （子仓库内运行 `pnpm dlx fallow` 时优先于主仓库根配置）。
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    // 顶层规则豁免（有意设计，勿删）：
    //  - dev-dependencies-in-production：@napuketto/kernel、@napuketto/loader 刻意放
    //    devDependencies——发布形态自包含（tsdown 把 @napuketto/* bundle 进
    //    lib/index.cjs，运行时只依赖 koishi peer；见 HANDOVER.md §5 发布形态）。
    //    若移 dependencies：npm 安装插件时会解析 workspace 版本（包未发布则装不上），
    //    且 tsdown 默认 external dependencies 会破坏 bundle 自包含。
    "rules": {
        "dev-dependencies-in-production": "off"
    },
    // koishi 框架契约豁免（overrides 按文件精准关闭，保留文件内其他 finding）：
    //  - src/bot/bot.ts：NapukettoBot 全部 override 方法是 koishi Bot 接口实现
    //    （start/stop/getMessageList/getLogin/getFriendList/getChannel/... 框架多态
    //    调用）+ MessageEncoder static（koishi 按 bot.constructor.MessageEncoder
    //    反射查找），静态分析无引用
    //  - src/ipc/client.ts：alive/sendControl 被 driver.ts 经「null 联合类型 +
    //    属性访问」调用（stop() 里 current.alive / current.sendControl），
    //    fallow 流分析漏报（实际有消费者）
    //  - src/driver/driver.ts：restartAttempts 是测试断言（driver-restart.test.ts）
    //    + 诊断用公共 getter
    "overrides": [
        {
            "files": [
                "src/bot/bot.ts",
                "src/ipc/client.ts",
                "src/driver/driver.ts"
            ],
            "rules": {
                "unused-class-members": "off"
            }
        }
    ],
    // 公共 API 面豁免：
    //  - src/login/index.ts：LoginObserver/LoginSnapshot/LoginView 是登录交互公共
    //    类型（LoginView 供 bot.ts QR 展示接入，HANDOVER 待办 2 即将使用）
    "ignoreFindings": [
        "src/login/index.ts"
    ],
    // class + namespace 声明合并（bot.ts `export class NapukettoBot` + 文件尾
    // `export namespace NapukettoBot`，napcat 同构模式：Config 常量/类型合并到类
    // 上）——fallow 误判 duplicate-export，按导出名精准豁免。
    "ignoreExports": [
        {
            "file": "src/bot/bot.ts",
            "exports": [
                "NapukettoBot"
            ]
        }
    ]
}